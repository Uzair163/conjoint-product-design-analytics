            <column caption='Utility Change by $1' datatype='real' name='[Calculation_777433897554022410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='500/(Avg([1000 GBP]) - Avg([1500 GBP]))' />
            </column>
            <column caption='WTP – 30%' datatype='real' name='[Calculation_777433897556099083]' role='measure' type='quantitative'>
