      <column caption='Environment' datatype='real' name='[Calculation_438538025583271936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([0% CO2 reduction], MAX([30% CO2 reduction],[50% CO2 reduction])) - MIN([0% CO2 reduction],MIN([30% CO2 reduction], [50% CO2 reduction]))' />
      </column>
      <column caption='Delivery Time' datatype='real' name='[Calculation_438538025584668673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([14 days], MAX([21 days],[30 days])) - MIN([14 days],MIN([21 days],[30 days]))' />
      </column>
      <column caption='Service Level' datatype='real' name='[Calculation_777433897548447744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([5-year warranty], MAX([5-year warranty &amp; free maintenance],[5-year warranty, free maintenance and installation, &amp; upgradeability])) - MIN([5-year warranty],MIN([5-year warranty &amp; free maintenance],[5-year warranty, free maintenance and installation, &amp; upgradeability]))' />
      </column>
      <column caption='Price' datatype='real' name='[Calculation_777433897548791809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([1000 GBP], MAX([1200 GBP],[1500 GBP])) - MIN([1000 GBP],MIN([1200 GBP],[1500 GBP]))' />
      </column>
      <column caption='Quality of Materials' datatype='real' name='[Calculation_777433897549086722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Market average], [A bit higher than market average]) - MIN([Market average], [A bit higher than market average])' />
      </column>
      <column caption='Market Proficiency' datatype='real' name='[Calculation_777433897549393923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Not very proficient and poor communication], [Very proficient and have good communication skills]) - MIN([Not very proficient and poor communication], [Very proficient and have good communication skills])' />
      </column>
      <column caption='Environment %' datatype='real' name='[Calculation_777433897551224836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_438538025583271936])/ (AVG([Calculation_438538025583271936]) + AVG([Calculation_438538025584668673])+ AVG([Calculation_777433897548447744])+AVG([Calculation_777433897548791809])+ AVG([Calculation_777433897549086722])+ AVG([Calculation_777433897549393923]))' />
      </column>
      <column caption='Delivery Time %' datatype='real' name='[Calculation_777433897551855621]' role='measure' type='quantitative'>
