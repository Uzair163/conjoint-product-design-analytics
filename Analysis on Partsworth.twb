            <column caption='WTP - 30' datatype='real' name='[Calculation_777433897556504590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([30 days])*[Calculation_777433897554022410]' />
            </column>
            <column caption='WTP - Warranty and Maintenance' datatype='real' name='[Calculation_777433897556623375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([5-year warranty &amp; free maintenance])*[Calculation_777433897554022410]' />
            </column>
            <column caption='WTP - Warranty, Maintenance and Upgrade' datatype='real' name='[Calculation_777433897556885520]' role='measure' type='quantitative'>
